# Copy to server/.env.local and fill in. Generate tokens with: python3 -c 'import secrets;print(secrets.token_urlsafe(24))'
MAC_TOKENS=<token for Macs; comma-separate several>
ROBOT_TOKEN=<token for the robot>
ROBOT_SECRET=<random path segment for the robot endpoint>
PREVIEW_TOKEN=
GEMINI_API_KEY=<Gemini key, used for push-to-talk transcription>
QUIET_HOURS=22-8
TZ_OFFSET_MINUTES=330
LISTEN_PORT=8810
